# MongoDB (Atlas free tier). Use MONGODB_URI, or DB_PASSWORD for the existing cluster.
MONGODB_URI=
DB_PASSWORD=

# Resend (https://resend.com) – with onboarding@resend.dev you can only send to your own email
API_KEY_RESEND=
NOTIFY_EMAIL=
# EMAIL_FROM=OfferAlert <onboarding@resend.dev>

PORT=4000
# Cron inside the server. Set to false where the server sleeps (Render free) and use the GitHub Action.
ENABLE_CRON=true
CHECK_CRON=*/30 * * * *

# Only for the Puppeteer fallback (Pull&Bear / Bershka)
# EXECUTABLE_PATH=
